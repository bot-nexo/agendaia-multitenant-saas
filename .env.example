# Supabase Configuration
SUPABASE_URL="https://TU_PROYECTO.supabase.co"
SUPABASE_ANON_KEY="TU_ANON_KEY_PUBLICA"
SUPABASE_SERVICE_ROLE_KEY="TU_SERVICE_ROLE_KEY_PRIVADA"

# Vite client env (deben ser las mismas que SUPABASE_URL y SUPABASE_ANON_KEY)
VITE_SUPABASE_URL="https://TU_PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="TU_ANON_KEY_PUBLICA"

# Gemini AI API (para el bot de WhatsApp)
GEMINI_API_KEY="TU_GEMINI_API_KEY"

# App URL
APP_URL="http://localhost:3000"

# Server Port
PORT=3000

# Payment channels (exposed to frontend via VITE_ prefix)
VITE_PAYMENT_NEQUI_PHONE="+573001234567"
VITE_PAYMENT_BANCOLOMBIA_ACCOUNT="123-456789-00"
VITE_PAYMENT_NIT="901.888.777-1"
